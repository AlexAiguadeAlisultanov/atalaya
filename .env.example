# Configuración de ATALAYA. Copia este fichero a .env (que está en .gitignore).
# Todo es opcional: sin nada, funciona con los límites gratuitos de las fuentes.

# Puerto del servidor (Render lo inyecta solo).
PORT=3099

# Ruta del fichero SQLite de caché y uso diario.
ATALAYA_DB_PATH=atalaya.db

# Clave de API de NVD (opcional). Sin ella: 5 peticiones/30s. Con ella sube el límite.
# Se consigue gratis en https://nvd.nist.gov/developers/request-an-api-key
# ATALAYA_NVD_KEY=

# Análisis EN VIVO permitidos por cliente y día (los dominios demo no gastan cuota).
ATALAYA_LIMITE_DIARIO=5
